{
  "description": "Keeps C# edits on the validate_patch write path (including a write-shaped Bash command), keeps C# reads on search_index/get_symbol (including via Bash), delivers the write-time checklist on the session's first validate_patch, refreshes the syntax index, live workspace and symbol store (via a loopback control channel) for every .cs file a tool just wrote, so an edit is queryable before the next call, and meters every tool call's request and response tokens so MCP and raw-tool routes are measured on one instrument. Every hook is a subcommand of the published server binary, so it runs wherever the .NET runtime the plugin already requires runs - no shell, no shebang, no jq/node/python3. The metering hook alone matches every tool (matcher \"*\"): it is the only one whose question is about tools it does not otherwise see, and it observes without ever withholding a call.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "dotnet \"${CLAUDE_PLUGIN_ROOT}/dist/DotnetToolkit.McpServer.dll\" hook guard-cs-edit",
            "timeout": 10,
            "statusMessage": "Checking C# write path..."
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "dotnet \"${CLAUDE_PLUGIN_ROOT}/dist/DotnetToolkit.McpServer.dll\" hook guard-cs-read",
            "timeout": 10,
            "statusMessage": "Checking C# read path..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "dotnet \"${CLAUDE_PLUGIN_ROOT}/dist/DotnetToolkit.McpServer.dll\" hook guard-cs-bash-write",
            "timeout": 10,
            "statusMessage": "Checking Bash command for a raw C# write..."
          },
          {
            "type": "command",
            "command": "dotnet \"${CLAUDE_PLUGIN_ROOT}/dist/DotnetToolkit.McpServer.dll\" hook guard-cs-bash-read",
            "timeout": 10,
            "statusMessage": "Checking Bash command for a raw C# read..."
          }
        ]
      },
      {
        "matcher": ".*__validate_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "dotnet \"${CLAUDE_PLUGIN_ROOT}/dist/DotnetToolkit.McpServer.dll\" hook hint-write-checklist",
            "timeout": 10,
            "statusMessage": "Checking whether the write-time checklist is still owed..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|apply_patch|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "dotnet \"${CLAUDE_PLUGIN_ROOT}/dist/DotnetToolkit.McpServer.dll\" hook refresh-cs-files",
            "timeout": 15,
            "statusMessage": "Refreshing the C# index for the files just written..."
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "dotnet \"${CLAUDE_PLUGIN_ROOT}/dist/DotnetToolkit.McpServer.dll\" hook meter-tool-call",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "dotnet \"${CLAUDE_PLUGIN_ROOT}/dist/DotnetToolkit.McpServer.dll\" hook track-subagent-start",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "dotnet \"${CLAUDE_PLUGIN_ROOT}/dist/DotnetToolkit.McpServer.dll\" hook track-subagent-stop",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
