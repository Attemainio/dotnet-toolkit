{
  "description": "Keeps C# edits on the validate_patch write path, keeps C# reads on search_index/get_symbol (including via Bash), delivers the write-time checklist on the session's first validate_patch, and refreshes the workspace (via a loopback control channel, falling back to a reminder) after creating a new .cs file. Every hook is a subcommand of the published server binary, so it runs wherever the .NET runtime the plugin already requires runs - no shell, no shebang, no jq/node/python3.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "dotnet \"${CLAUDE_PLUGIN_ROOT}/dist/DotnetToolkit.McpServer.dll\" hook guard-cs-edit",
            "timeout": 10,
            "statusMessage": "Checking C# write path..."
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "dotnet \"${CLAUDE_PLUGIN_ROOT}/dist/DotnetToolkit.McpServer.dll\" hook guard-cs-read",
            "timeout": 10,
            "statusMessage": "Checking C# read path..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "dotnet \"${CLAUDE_PLUGIN_ROOT}/dist/DotnetToolkit.McpServer.dll\" hook guard-cs-bash-read",
            "timeout": 10,
            "statusMessage": "Checking Bash command for a raw C# read..."
          }
        ]
      },
      {
        "matcher": "mcp__plugin_dotnet-toolkit_dotnet__validate_patch",
        "hooks": [
          {
            "type": "command",
            "command": "dotnet \"${CLAUDE_PLUGIN_ROOT}/dist/DotnetToolkit.McpServer.dll\" hook hint-write-checklist",
            "timeout": 10,
            "statusMessage": "Checking whether the write-time checklist is still owed..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "dotnet \"${CLAUDE_PLUGIN_ROOT}/dist/DotnetToolkit.McpServer.dll\" hook hint-reload-new-cs-file",
            "timeout": 10,
            "statusMessage": "Checking whether the workspace needs a reload..."
          }
        ]
      }
    ]
  }
}
