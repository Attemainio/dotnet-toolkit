bin/
obj/
.vs/

# Built by scripts/package-plugin.sh|.cmd from files that ARE tracked, so it is a build output like
# bin/. dist/ is committed and this is not, because dist/ is what a `git clone` consumer runs while
# this exists only to give a LOCAL marketplace a source that is not the whole working tree.
package/
*.user
.claude/settings.local.json
.claude/agent-memory/

# dotnet-toolkit's run output - review/, eval/, perf/ and init's backups/ - is ignored one level
# down, by .claude/dotnet-toolkit/.gitignore. That is the same file dotnet-init copies into a
# consuming repo, so this repo ignores exactly what a consumer's does, and the rule lives next to
# what it covers rather than being restated here. cache/ self-ignores; install.json and config.json
# are tracked on purpose. Nothing to add here.
